{
  "contract": 2,
  "policyKind": "desired",
  "repository": "SouthernGentlemen/Boneyard",
  "defaultBranch": "main",
  "mergeMethods": {
    "mergeCommit": false,
    "squash": true,
    "rebase": false
  },
  "deleteBranchOnMerge": true,
  "requiredStatusChecks": [
    {
      "name": "verify",
      "exactHead": true
    }
  ],
  "mainProtection": {
    "rulesetName": "main-protection",
    "protected": true,
    "requirePullRequest": true,
    "requireBranchUpToDate": true,
    "allowDeletion": false,
    "allowForcePush": false,
    "bypassActors": [],
    "requireExtraApprovalForUnattributedChanges": true,
    "requiredReviewThreadResolution": false,
    "doNotEnforceOnCreate": true
  },
  "workflowPermissions": {
    "defaultWorkflowPermissions": "read",
    "canApprovePullRequestReviews": false
  },
  "releaseTags": {
    "rulesetName": "release-tag-immutability",
    "pattern": "v*",
    "enforcement": "active",
    "immutable": true,
    "allowDeletion": false,
    "allowUpdate": false,
    "bypassActors": []
  },
  "capabilities": {
    "kind": "asset-data-library",
    "browserRuntime": false,
    "server": false,
    "worker": false,
    "pages": false,
    "deployment": false,
    "npmPublication": false
  }
}
