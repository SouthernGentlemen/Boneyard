{
  "name": "boneyard",
  "version": "0.1.0",
  "private": true,
  "description": "The rig, the art and the motion. One source of truth, consumed by every lab.",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "26.9.0",
    "npm": "11.19.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./paths": "./src/paths.ts",
    "./motion": "./pipelines/motion/catalog.ts",
    "./motion/build": "./pipelines/motion/build.ts",
    "./motion/reduce": "./pipelines/motion/reduce.ts",
    "./bundle": "./pipelines/bundle.ts",
    "./wardrobe/index": "./pipelines/wardrobe/index.ts",
    "./wardrobe/build": "./pipelines/wardrobe/build.ts",
    "./sprite/build": "./pipelines/sprite/build.ts",
    "./render/sheet": "./pipelines/render/sheet.ts",
    "./render/depth": "./pipelines/render/depth.ts",
    "./render/manifest": "./pipelines/render/manifest.ts",
    "./render/schemas": "./pipelines/render/schemas.ts",
    "./guards/footprint": "./pipelines/guards/footprint.ts",
    "./rigs/*": "./rigs/*",
    "./figures/*": "./figures/*",
    "./characters/*": "./characters/*",
    "./cosmetics/*": "./cosmetics/*",
    "./catalog/*": "./catalog/*",
    "./motions/*": "./motions/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:rig": "node pipelines/guards/rig.ts",
    "build:parts": "node pipelines/sprite/build.ts",
    "check:sprites": "node pipelines/sprite/build.ts --check",
    "check:sockets": "node pipelines/guards/sockets.ts",
    "build:cosmetics": "node pipelines/wardrobe/build.ts",
    "check:wardrobe": "node pipelines/wardrobe/build.ts --check && node pipelines/guards/wardrobe.ts",
    "build:motions": "node pipelines/motion/build.ts",
    "check:motions": "node pipelines/motion/build.ts --check",
    "build:bundle": "node pipelines/bundle.ts",
    "check:bundle": "node pipelines/bundle.ts --check",
    "build": "npm run build:parts && npm run build:cosmetics && npm run build:motions && npm run build:bundle",
    "render:clip": "node pipelines/render/clip.ts",
    "render:figure": "node pipelines/render/figure.ts",
    "export:motions": "node pipelines/exchange/export.ts",
    "import:motions": "node pipelines/exchange/import.ts",
    "blender": "node pipelines/exchange/export.ts --blend",
    "check:exchange": "node pipelines/guards/exchange.ts",
    "check:footprint": "node pipelines/guards/footprint.ts",
    "check:cruft": "node pipelines/guards/cruft.ts",
    "check:history": "node pipelines/guards/history.ts",
    "check:blender": "node pipelines/guards/blender.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check:history && npm run check:rig && npm run check:sprites && npm run check:sockets && npm run check:motions && npm run check:bundle && npm run check:exchange && npm run check:wardrobe && npm run check:cruft && npm run check:footprint && npm run typecheck && npm test && npm run test:library-boundary && npm run test:release-workflow && npm run test:release-identity && npm run test:github-settings && npm run test:shared-contract && npm run check:blender",
    "verify": "npm run check",
    "test:github-settings": "node --test test/github-settings-policy.test.mjs",
    "verify:github-settings": "node scripts/verify-github-settings.mjs",
    "apply:github-settings": "node scripts/apply-github-settings.mjs",
    "test:release-workflow": "node --test test/release-workflow.test.mjs",
    "test:release-identity": "node --test test/release-identity.test.mjs",
    "verify:release-identity": "node scripts/release-identity.mjs",
    "test:library-boundary": "node --test test/library-boundary.test.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "test:shared-contract": "node --test test/shared-contract.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
