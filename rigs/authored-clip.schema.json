{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svglab.local/rigs/authored-clip.schema.json",
  "title": "SVGLab authored clip",
  "description": "Authored source at 60 Hz. Every clip holds exactly 13 poses; duration is free. build:motions also checks loop closure, file-name agreement, provenance, and rig references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "derivedFrom",
    "loop",
    "duration",
    "easing",
    "note",
    "poses"
  ],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^(bnr|lab)[A-Za-z0-9]+$"
    },
    "derivedFrom": {
      "type": [
        "string",
        "null"
      ]
    },
    "loop": {
      "type": "boolean"
    },
    "duration": {
      "type": "integer",
      "minimum": 1,
      "description": "Playback length in integer 60 Hz ticks, independent of the pose count."
    },
    "easing": {
      "enum": [
        "linear",
        "smoothstep"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "poses": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "description": "Exactly 13 poses at evenly spaced phases, pose 0 to pose 12. A looping clip's last pose is its first.",
      "items": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "arm-back",
            "arm-front",
            "forearm-back",
            "forearm-front",
            "head",
            "leg-back",
            "leg-front",
            "pelvis",
            "shin-back",
            "shin-front",
            "torso"
          ]
        },
        "additionalProperties": {
          "$ref": "#/$defs/bonePose"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "key": {
            "pattern": "^lab"
          }
        },
        "required": [
          "key"
        ]
      },
      "then": {
        "properties": {
          "derivedFrom": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "key": {
            "pattern": "^bnr"
          }
        },
        "required": [
          "key"
        ]
      },
      "then": {
        "properties": {
          "derivedFrom": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "bonePose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        }
      }
    }
  }
}
